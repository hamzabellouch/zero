#include <windows.h>
#include "resource.h"

// RT_MANIFEST is type 24
1 24 "app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Zero Projects\0"
            VALUE "FileDescription", "Zero - Portable Uninstaller & Leftover Cleaner\0"
            VALUE "FileVersion", "0.0.1-beta\0"
            VALUE "InternalName", "Zero\0"
            VALUE "OriginalFilename", "Zero.exe\0"
            VALUE "ProductName", "Zero\0"
            VALUE "ProductVersion", "0.0.1-beta\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
